# Dependencies
node_modules/

# Build output
dist/
build/
web-build/

# Expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Native folders — generated by `expo prebuild`, never hand-edited
/apps/mobile/ios/
/apps/mobile/android/

# Env and secrets — NEVER commit these
.env
.env.*
!.env.example

# Local database scratch
pgdata/

# Agent worktrees. The harness checks a branch out under here for each agent it
# runs in isolation, so this is one or more live git working trees rather than
# anything of ours — committing it would nest the repo inside itself. Anything
# else under `.claude/` (settings, skills) is still tracked.
.claude/worktrees/

# OS / editor
.DS_Store
*.log

# ui-check output
apps/mobile/.web/
.ui-check/

# Assembled site
_site/
