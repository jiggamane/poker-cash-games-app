# Copy to .env and fill in from your Supabase project settings.
# .env is gitignored. Never commit real keys.
#
# EXPO_PUBLIC_ variables are embedded in the app bundle and are readable by
# anyone who installs it. That is fine for these two — the anon key is designed
# to be public, and the database's row-level security is what actually protects
# the data.
#
# The service_role key must NEVER appear here or anywhere in apps/. It bypasses
# every security rule. It belongs only in server-side edge functions.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
